diff --git a/drivers/gpu/drm/i915/display/intel_ddi.c b/drivers/gpu/drm/i915/display/intel_ddi.c
index 59f89f19e..e2bd88d59 100644
--- a/drivers/gpu/drm/i915/display/intel_ddi.c
+++ b/drivers/gpu/drm/i915/display/intel_ddi.c
@@ -2179,7 +2179,7 @@ icl_program_mg_dp_mode(struct intel_digital_port *dig_port,
 	    intel_tc_port_in_tbt_alt_mode(dig_port))
 		return;
 
-	if (DISPLAY_VER(display) >= 12) {
+	if (intel_display_has_dkl_phy(display)) {
 		ln0 = intel_dkl_phy_read(display, DKL_DP_MODE(tc_port, 0));
 		ln1 = intel_dkl_phy_read(display, DKL_DP_MODE(tc_port, 1));
 	} else {
@@ -2241,7 +2241,7 @@ icl_program_mg_dp_mode(struct intel_digital_port *dig_port,
 		MISSING_CASE(pin_assignment);
 	}
 
-	if (DISPLAY_VER(display) >= 12) {
+	if (intel_display_has_dkl_phy(display)) {
 		intel_dkl_phy_write(display, DKL_DP_MODE(tc_port, 0), ln0);
 		intel_dkl_phy_write(display, DKL_DP_MODE(tc_port, 1), ln1);
 		 /* WA_14018221282 */
@@ -5268,6 +5268,19 @@ void intel_ddi_init(struct intel_display *display,
 		encoder->disable_clock = dg1_ddi_disable_clock;
 		encoder->is_clock_enabled = dg1_ddi_is_clock_enabled;
 		encoder->get_config = dg1_ddi_get_config;
+	} else if (intel_display_lkf_tc(display)) {
+		if (intel_encoder_is_tc(encoder)) {
+			encoder->enable_clock = icl_ddi_tc_enable_clock;
+			encoder->disable_clock = icl_ddi_tc_disable_clock;
+			encoder->is_clock_enabled = icl_ddi_tc_is_clock_enabled;
+			encoder->port_pll_type = icl_ddi_tc_port_pll_type;
+			encoder->get_config = icl_ddi_tc_get_config;
+		} else {
+			encoder->enable_clock = icl_ddi_combo_enable_clock;
+			encoder->disable_clock = icl_ddi_combo_disable_clock;
+			encoder->is_clock_enabled = icl_ddi_combo_is_clock_enabled;
+			encoder->get_config = icl_ddi_combo_get_config;
+		}
 	} else if (display->platform.jasperlake || display->platform.elkhartlake) {
 		if (intel_ddi_is_tc(display, port)) {
 			encoder->enable_clock = jsl_ddi_tc_enable_clock;
@@ -5321,6 +5334,8 @@ void intel_ddi_init(struct intel_display *display,
 	} else if (DISPLAY_VER(display) >= 11) {
 		if (intel_encoder_is_combo(encoder))
 			encoder->set_signal_levels = icl_combo_phy_set_signal_levels;
+		else if (intel_display_has_dkl_phy(display))
+			encoder->set_signal_levels = tgl_dkl_phy_set_signal_levels;
 		else
 			encoder->set_signal_levels = icl_mg_phy_set_signal_levels;
 	} else if (display->platform.geminilake || display->platform.broxton) {
@@ -5339,6 +5354,9 @@ void intel_ddi_init(struct intel_display *display,
 		encoder->hpd_pin = rkl_hpd_pin(display, port);
 	else if (DISPLAY_VER(display) >= 12)
 		encoder->hpd_pin = tgl_hpd_pin(display, port);
+	else if (intel_display_lkf_tc(display))
+		encoder->hpd_pin = port >= PORT_D ? HPD_PORT_TC1 + port - PORT_D :
+						   HPD_PORT_A + port - PORT_A;
 	else if (display->platform.jasperlake || display->platform.elkhartlake)
 		encoder->hpd_pin = ehl_hpd_pin(display, port);
 	else if (DISPLAY_VER(display) == 11)
diff --git a/drivers/gpu/drm/i915/display/intel_ddi_buf_trans.c b/drivers/gpu/drm/i915/display/intel_ddi_buf_trans.c
index a238be5bc..ca9702076 100644
--- a/drivers/gpu/drm/i915/display/intel_ddi_buf_trans.c
+++ b/drivers/gpu/drm/i915/display/intel_ddi_buf_trans.c
@@ -1734,6 +1734,8 @@ void intel_ddi_buf_trans_init(struct intel_encoder *encoder)
 			encoder->get_buf_trans = tgl_get_combo_buf_trans;
 		else
 			encoder->get_buf_trans = tgl_get_dkl_buf_trans;
+	} else if (intel_display_lkf_tc(display) && !intel_encoder_is_combo(encoder)) {
+		encoder->get_buf_trans = tgl_get_dkl_buf_trans;
 	} else if (DISPLAY_VER(display) == 11) {
 		if (display->platform.jasperlake)
 			encoder->get_buf_trans = jsl_get_combo_buf_trans;
diff --git a/drivers/gpu/drm/i915/display/intel_display.c b/drivers/gpu/drm/i915/display/intel_display.c
index cf71ebe24..1f11b7184 100644
--- a/drivers/gpu/drm/i915/display/intel_display.c
+++ b/drivers/gpu/drm/i915/display/intel_display.c
@@ -1853,6 +1853,8 @@ bool intel_phy_is_tc(struct intel_display *display, enum phy phy)
 		return phy >= PHY_D && phy <= PHY_I;
 	else if (display->platform.icelake)
 		return phy >= PHY_C && phy <= PHY_F;
+	else if (intel_display_lkf_tc(display))
+		return phy == PHY_D || phy == PHY_E;
 
 	return false;
 }
@@ -1878,6 +1880,8 @@ enum phy intel_port_to_phy(struct intel_display *display, enum port port)
 		return PHY_B + port - PORT_TC1;
 	else if ((display->platform.dg1 || display->platform.rocketlake) && port >= PORT_TC1)
 		return PHY_C + port - PORT_TC1;
+	else if (intel_display_lkf_tc(display))
+		return PHY_A + port - PORT_A;
 	else if ((display->platform.jasperlake || display->platform.elkhartlake) &&
 		 port == PORT_D)
 		return PHY_A;
@@ -1893,6 +1897,8 @@ enum tc_port intel_port_to_tc(struct intel_display *display, enum port port)
 
 	if (DISPLAY_VER(display) >= 12)
 		return TC_PORT_1 + port - PORT_TC1;
+	else if (intel_display_lkf_tc(display))
+		return TC_PORT_1 + port - PORT_D;
 	else
 		return TC_PORT_1 + port - PORT_C;
 }
diff --git a/drivers/gpu/drm/i915/display/intel_display_device.c b/drivers/gpu/drm/i915/display/intel_display_device.c
index d46a9cd32..208f29e0e 100644
--- a/drivers/gpu/drm/i915/display/intel_display_device.c
+++ b/drivers/gpu/drm/i915/display/intel_display_device.c
@@ -972,6 +972,7 @@ static const struct intel_display_device_info lkf_display = {
 
 static const struct platform_desc lkf_desc = {
 	PLATFORM(elkhartlake),
+	PLATFORM_GROUP(lakefield),
 	.info = &lkf_display,
 	STEP_INFO(jsl_ehl_steppings),
 };
@@ -1680,6 +1681,22 @@ static const struct dmi_system_id lkf_display_validated[] = {
 	{ }
 };
 
+/*
+ * Lakefield Type-C (DP alt mode) display support on DDI D/E: ICL-style FIA,
+ * hot-plug and clocking, with the TGL Dekel PHY (as programmed by the
+ * Lakefield GOP). Experimental, behind i915.lkf_tc.
+ */
+bool intel_display_lkf_tc(struct intel_display *display)
+{
+	return display->platform.lakefield && display->params.lkf_tc;
+}
+
+/* Type-C PHY is a Dekel PHY (TGL..ADL-P, and Lakefield) rather than an ICL MG PHY */
+bool intel_display_has_dkl_phy(struct intel_display *display)
+{
+	return IS_DISPLAY_VER(display, 12, 13) || intel_display_lkf_tc(display);
+}
+
 static bool lkf_display_enabled(struct intel_display *display)
 {
 	if (display->params.lkf_display >= 0)
@@ -1810,6 +1827,10 @@ static void __intel_display_device_info_runtime_init(struct intel_display *displ
 	if (display->platform.icelake_port_f)
 		display_runtime->port_mask |= BIT(PORT_F);
 
+	/* Lakefield: DDI D/E are the Type-C ports TC1/TC2 (DP alt mode) */
+	if (intel_display_lkf_tc(display))
+		display_runtime->port_mask |= BIT(PORT_E);
+
 	/* Wa_14011765242: adl-s A0,A1 */
 	if (display->platform.alderlake_s && IS_DISPLAY_STEP(display, STEP_A0, STEP_A2))
 		for_each_pipe(display, pipe)
diff --git a/drivers/gpu/drm/i915/display/intel_display_device.h b/drivers/gpu/drm/i915/display/intel_display_device.h
index a910642d5..f90ff2005 100644
--- a/drivers/gpu/drm/i915/display/intel_display_device.h
+++ b/drivers/gpu/drm/i915/display/intel_display_device.h
@@ -77,6 +77,7 @@ struct pci_dev;
 	func(icelake_port_f) \
 	func(jasperlake) \
 	func(elkhartlake) \
+	func(lakefield) /* alias set together with elkhartlake */ \
 	/* Display ver 12 */ \
 	func(tigerlake) \
 	func(tigerlake_uy) \
@@ -310,6 +311,8 @@ struct intel_display_device_info {
 
 bool intel_display_device_present(struct intel_display *display);
 bool intel_display_device_enabled(struct intel_display *display);
+bool intel_display_lkf_tc(struct intel_display *display);
+bool intel_display_has_dkl_phy(struct intel_display *display);
 struct intel_display *intel_display_device_probe(struct pci_dev *pdev);
 void intel_display_device_remove(struct intel_display *display);
 void intel_display_device_info_runtime_init(struct intel_display *display);
diff --git a/drivers/gpu/drm/i915/display/intel_display_params.c b/drivers/gpu/drm/i915/display/intel_display_params.c
index abee689fe..fbfd873a3 100644
--- a/drivers/gpu/drm/i915/display/intel_display_params.c
+++ b/drivers/gpu/drm/i915/display/intel_display_params.c
@@ -139,6 +139,10 @@ intel_display_param_named_unsafe(lkf_display, int, 0400,
 	"(-1 = auto [default]: on for validated machines (ThinkPad X1 Fold Gen 1), "
 	"0 = render/media only, firmware framebuffer stays on simpledrm, 1 = on)");
 
+intel_display_param_named_unsafe(lkf_tc, bool, 0400,
+	"Lakefield: enable the USB-C DP alt mode ports DDI D/E (experimental) "
+	"(0=disabled [default], 1=enabled)");
+
 intel_display_param_named_unsafe(enable_dmc_wl, int, 0400,
 	"Enable DMC wakelock "
 	"(-1=use per-chip default, 0=disabled, 1=enabled, 2=match any register, 3=always locked) "
diff --git a/drivers/gpu/drm/i915/display/intel_display_params.h b/drivers/gpu/drm/i915/display/intel_display_params.h
index a633560dc..4c3e6908b 100644
--- a/drivers/gpu/drm/i915/display/intel_display_params.h
+++ b/drivers/gpu/drm/i915/display/intel_display_params.h
@@ -51,6 +51,7 @@ struct drm_printer;
 	param(bool, enable_psr2_sel_fetch, true, 0400) \
 	param(int, enable_dmc_wl, -1, 0400) \
 	param(int, lkf_display, -1, 0400) \
+	param(bool, lkf_tc, false, 0400) \
 
 #define MEMBER(T, member, ...) T member;
 struct intel_display_params {
diff --git a/drivers/gpu/drm/i915/display/intel_dpll_mgr.c b/drivers/gpu/drm/i915/display/intel_dpll_mgr.c
index 8ea96cc52..6e0c9c976 100644
--- a/drivers/gpu/drm/i915/display/intel_dpll_mgr.c
+++ b/drivers/gpu/drm/i915/display/intel_dpll_mgr.c
@@ -3017,7 +3017,7 @@ static int icl_calc_mg_pll_state(struct intel_crtc_state *crtc_state,
 	u64 tmp;
 	bool use_ssc = false;
 	bool is_dp = !intel_crtc_has_type(crtc_state, INTEL_OUTPUT_HDMI);
-	bool is_dkl = DISPLAY_VER(display) >= 12;
+	bool is_dkl = intel_display_has_dkl_phy(display);
 	int ret;
 
 	ret = icl_mg_pll_find_divisors(clock, is_dp, use_ssc, &dco_khz,
@@ -3216,7 +3216,7 @@ static int icl_ddi_mg_pll_get_freq(struct intel_display *display,
 
 	ref_clock = display->dpll.ref_clks.nssc;
 
-	if (DISPLAY_VER(display) >= 12) {
+	if (intel_display_has_dkl_phy(display)) {
 		m1 = hw_state->mg_pll_div0 & DKL_PLL_DIV0_FBPREDIV_MASK;
 		m1 = m1 >> DKL_PLL_DIV0_FBPREDIV_SHIFT;
 		m2_int = hw_state->mg_pll_div0 & DKL_PLL_DIV0_FBDIV_INT_MASK;
@@ -3384,7 +3384,7 @@ static int icl_get_combo_phy_dpll(struct intel_atomic_state *state,
 			BIT(DPLL_ID_ICL_DPLL0);
 	} else if ((display->platform.jasperlake ||
 		    display->platform.elkhartlake) &&
-		   port != PORT_A) {
+		   !intel_display_lkf_tc(display) && port != PORT_A) {
 		dpll_mask =
 			BIT(DPLL_ID_EHL_DPLL4) |
 			BIT(DPLL_ID_ICL_DPLL1) |
@@ -4015,7 +4015,7 @@ static void mg_pll_enable(struct intel_display *display,
 
 	icl_pll_power_enable(display, pll, enable_reg);
 
-	if (DISPLAY_VER(display) >= 12)
+	if (intel_display_has_dkl_phy(display))
 		dkl_pll_write(display, pll, hw_state);
 	else
 		icl_mg_pll_write(display, pll, hw_state);
@@ -4237,6 +4237,28 @@ static const struct dpll_info rkl_plls[] = {
 	{}
 };
 
+/* Lakefield with Type-C: ICL combo PLLs, ICL TBT PLL, TC PLLs on the Dekel PHY */
+static const struct dpll_info lkf_plls[] = {
+	{ .name = "DPLL 0", .funcs = &combo_pll_funcs, .id = DPLL_ID_ICL_DPLL0, },
+	{ .name = "DPLL 1", .funcs = &combo_pll_funcs, .id = DPLL_ID_ICL_DPLL1, },
+	{ .name = "TBT PLL", .funcs = &tbt_pll_funcs, .id = DPLL_ID_ICL_TBTPLL,
+	  .is_alt_port_dpll = true, },
+	{ .name = "TC PLL 1", .funcs = &dkl_pll_funcs, .id = DPLL_ID_ICL_MGPLL1, },
+	{ .name = "TC PLL 2", .funcs = &dkl_pll_funcs, .id = DPLL_ID_ICL_MGPLL2, },
+	{}
+};
+
+static const struct intel_dpll_mgr lkf_pll_mgr = {
+	.dpll_info = lkf_plls,
+	.compute_dplls = icl_compute_dplls,
+	.get_dplls = icl_get_dplls,
+	.put_dplls = icl_put_dplls,
+	.update_active_dpll = icl_update_active_dpll,
+	.update_ref_clks = icl_update_dpll_ref_clks,
+	.dump_hw_state = icl_dump_hw_state,
+	.compare_hw_state = icl_compare_hw_state,
+};
+
 static const struct intel_dpll_mgr rkl_pll_mgr = {
 	.dpll_info = rkl_plls,
 	.compute_dplls = icl_compute_dplls,
@@ -4333,6 +4355,8 @@ void intel_dpll_init(struct intel_display *display)
 		dpll_mgr = &rkl_pll_mgr;
 	else if (DISPLAY_VER(display) >= 12)
 		dpll_mgr = &tgl_pll_mgr;
+	else if (intel_display_lkf_tc(display))
+		dpll_mgr = &lkf_pll_mgr;
 	else if (display->platform.jasperlake || display->platform.elkhartlake)
 		dpll_mgr = &ehl_pll_mgr;
 	else if (DISPLAY_VER(display) >= 11)
diff --git a/drivers/gpu/drm/i915/display/intel_tc.c b/drivers/gpu/drm/i915/display/intel_tc.c
index c4a5601c5..b26bba3fb 100644
--- a/drivers/gpu/drm/i915/display/intel_tc.c
+++ b/drivers/gpu/drm/i915/display/intel_tc.c
@@ -526,15 +526,18 @@ static u32 icl_tc_phy_hpd_live_status(struct intel_tc_port *tc)
 {
 	struct intel_display *display = to_intel_display(tc->dig_port);
 	struct intel_digital_port *dig_port = tc->dig_port;
-	u32 isr_bit = display->hotplug.pch_hpd[dig_port->base.hpd_pin];
+	/* No PCH (Lakefield): no south HPD table/ISR, hence no legacy TC mode */
+	u32 isr_bit = display->hotplug.pch_hpd ?
+		display->hotplug.pch_hpd[dig_port->base.hpd_pin] : 0;
 	intel_wakeref_t wakeref;
 	u32 fia_isr;
-	u32 pch_isr;
+	u32 pch_isr = 0;
 	u32 mask = 0;
 
 	with_intel_display_power(display, tc_phy_cold_off_domain(tc), wakeref) {
 		fia_isr = intel_de_read(display, PORT_TX_DFLEXDPSP(tc->phy_fia));
-		pch_isr = intel_de_read(display, SDEISR);
+		if (isr_bit)
+			pch_isr = intel_de_read(display, SDEISR);
 	}
 
 	if (fia_isr == 0xffffffff) {
-- 
