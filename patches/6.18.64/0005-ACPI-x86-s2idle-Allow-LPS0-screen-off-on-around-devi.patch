From d00e0e4bee6db5ceaff6a99a64e70b8dde949aff Mon Sep 17 00:00:00 2001
From: fmillion <47171880+fmillion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 01:29:34 +0000
Subject: [PATCH 05/45] ACPI: x86: s2idle: Allow LPS0 screen off/on around
 device suspend

On the Lenovo ThinkPad X1 Fold Gen 1 the LPS0 "screen off" and
"screen on" _DSM functions update the ECLite embedded controller
(power LED / standby state, keyboard dock state). ECLite is reached
through the Integrated Sensor Hub, which has been suspended and has its
interrupt masked by the time acpi_s2idle_prepare_late() runs in the
noirq phase, so every request times out (2 s each) and the EC never
learns the system entered standby.

Windows sends the display-off notification well before devices are
suspended. Add a DMI quirk (and an lps0_screen_off_early module
parameter to override it) that issues screen off from ->begin() and
screen on from ->end() instead, keeping the rest of the LPS0 sequence
unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/acpi/x86/s2idle.c | 106 +++++++++++++++++++++++++++++++-------
 1 file changed, 87 insertions(+), 19 deletions(-)

diff --git a/drivers/acpi/x86/s2idle.c b/drivers/acpi/x86/s2idle.c
index 377a26886..a684d8bd8 100644
--- a/drivers/acpi/x86/s2idle.c
+++ b/drivers/acpi/x86/s2idle.c
@@ -28,6 +28,42 @@ static bool sleep_no_lps0 __read_mostly;
 module_param(sleep_no_lps0, bool, 0644);
 MODULE_PARM_DESC(sleep_no_lps0, "Do not use the special LPS0 device interface");
 
+/*
+ * Some platforms implement the LPS0 "screen off"/"screen on" _DSM functions
+ * by talking to an embedded controller that sits behind a device which is
+ * already suspended (and has its interrupt masked) by the time
+ * acpi_s2idle_prepare_late() runs. Windows issues the display-off
+ * notification long before devices are suspended, so for those platforms run
+ * the screen off/on notifications from ->begin()/->end() instead.
+ */
+static int lps0_screen_off_early = -1;
+module_param(lps0_screen_off_early, int, 0644);
+MODULE_PARM_DESC(lps0_screen_off_early,
+		 "Run LPS0 screen off/on around device suspend (-1 = auto/DMI, 0 = no, 1 = yes)");
+
+static const struct dmi_system_id lps0_screen_off_early_dmi[] = {
+	{
+		/*
+		 * Lenovo ThinkPad X1 Fold Gen 1 (Lakefield): screen off/on
+		 * issue ECLite requests that go through the Integrated Sensor
+		 * Hub, which is suspended in the noirq phase.
+		 */
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "LENOVO"),
+			DMI_MATCH(DMI_PRODUCT_FAMILY, "ThinkPad X1 Fold Gen 1"),
+		},
+	},
+	{ }
+};
+
+static bool acpi_s2idle_screen_off_early(void)
+{
+	if (lps0_screen_off_early < 0)
+		lps0_screen_off_early = !!dmi_check_system(lps0_screen_off_early_dmi);
+
+	return lps0_screen_off_early > 0;
+}
+
 static const struct acpi_device_id lps0_device_ids[] = {
 	{"PNP0D80", },
 	{"", },
@@ -542,6 +578,51 @@ static struct acpi_scan_handler lps0_handler = {
 	.attach = lps0_device_attach,
 };
 
+static void acpi_s2idle_screen_off(void)
+{
+	if (lps0_dsm_func_mask > 0)
+		acpi_sleep_run_lps0_dsm(acpi_s2idle_vendor_amd() ?
+					ACPI_LPS0_SCREEN_OFF_AMD :
+					ACPI_LPS0_SCREEN_OFF,
+					lps0_dsm_func_mask, lps0_dsm_guid);
+
+	if (lps0_dsm_func_mask_microsoft > 0)
+		acpi_sleep_run_lps0_dsm(ACPI_LPS0_SCREEN_OFF,
+				lps0_dsm_func_mask_microsoft, lps0_dsm_guid_microsoft);
+}
+
+static void acpi_s2idle_screen_on(void)
+{
+	if (lps0_dsm_func_mask_microsoft > 0)
+		acpi_sleep_run_lps0_dsm(ACPI_LPS0_SCREEN_ON,
+				lps0_dsm_func_mask_microsoft, lps0_dsm_guid_microsoft);
+	if (lps0_dsm_func_mask > 0)
+		acpi_sleep_run_lps0_dsm(acpi_s2idle_vendor_amd() ?
+					ACPI_LPS0_SCREEN_ON_AMD :
+					ACPI_LPS0_SCREEN_ON,
+					lps0_dsm_func_mask, lps0_dsm_guid);
+}
+
+static int acpi_s2idle_begin_lps0(void)
+{
+	int ret = acpi_s2idle_begin();
+
+	if (!ret && lps0_device_handle && !sleep_no_lps0 &&
+	    acpi_s2idle_screen_off_early())
+		acpi_s2idle_screen_off();
+
+	return ret;
+}
+
+static void acpi_s2idle_end_lps0(void)
+{
+	if (lps0_device_handle && !sleep_no_lps0 &&
+	    acpi_s2idle_screen_off_early())
+		acpi_s2idle_screen_on();
+
+	acpi_s2idle_end();
+}
+
 int acpi_s2idle_prepare_late(void)
 {
 	struct acpi_s2idle_dev_ops *handler;
@@ -553,15 +634,8 @@ int acpi_s2idle_prepare_late(void)
 		lpi_check_constraints();
 
 	/* Screen off */
-	if (lps0_dsm_func_mask > 0)
-		acpi_sleep_run_lps0_dsm(acpi_s2idle_vendor_amd() ?
-					ACPI_LPS0_SCREEN_OFF_AMD :
-					ACPI_LPS0_SCREEN_OFF,
-					lps0_dsm_func_mask, lps0_dsm_guid);
-
-	if (lps0_dsm_func_mask_microsoft > 0)
-		acpi_sleep_run_lps0_dsm(ACPI_LPS0_SCREEN_OFF,
-				lps0_dsm_func_mask_microsoft, lps0_dsm_guid_microsoft);
+	if (!acpi_s2idle_screen_off_early())
+		acpi_s2idle_screen_off();
 
 	/* LPS0 entry */
 	if (lps0_dsm_func_mask > 0 && acpi_s2idle_vendor_amd())
@@ -631,25 +705,19 @@ void acpi_s2idle_restore_early(void)
 	}
 
 	/* Screen on */
-	if (lps0_dsm_func_mask_microsoft > 0)
-		acpi_sleep_run_lps0_dsm(ACPI_LPS0_SCREEN_ON,
-				lps0_dsm_func_mask_microsoft, lps0_dsm_guid_microsoft);
-	if (lps0_dsm_func_mask > 0)
-		acpi_sleep_run_lps0_dsm(acpi_s2idle_vendor_amd() ?
-					ACPI_LPS0_SCREEN_ON_AMD :
-					ACPI_LPS0_SCREEN_ON,
-					lps0_dsm_func_mask, lps0_dsm_guid);
+	if (!acpi_s2idle_screen_off_early())
+		acpi_s2idle_screen_on();
 }
 
 static const struct platform_s2idle_ops acpi_s2idle_ops_lps0 = {
-	.begin = acpi_s2idle_begin,
+	.begin = acpi_s2idle_begin_lps0,
 	.prepare = acpi_s2idle_prepare,
 	.prepare_late = acpi_s2idle_prepare_late,
 	.check = acpi_s2idle_check,
 	.wake = acpi_s2idle_wake,
 	.restore_early = acpi_s2idle_restore_early,
 	.restore = acpi_s2idle_restore,
-	.end = acpi_s2idle_end,
+	.end = acpi_s2idle_end_lps0,
 };
 
 void __init acpi_s2idle_setup(void)
-- 
